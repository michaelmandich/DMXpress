//! name: Neon Night
//! version: 1.0
//! author: DMXpress
//! description: Tints the whole console hot pink for late-set energy. Enable it and the accent, selection and focus colors follow.

// A theme-only plugin: no layer, no window - just a look.
fn theme() {
    #{
        accent: "#E23A8E",
        text: "#F6EFF4",
    }
}
